  <footer class="site-footer">
    <div class="wrap">
      <p class="footer-brand">Edinburgh Tours</p>
      <p>A fictional walking-tour company. Meeting points are sent by email.</p>
      <p><a href="/">Back to all tours</a></p>
    </div>
  </footer>

  <script>
    const BACKEND = "https://cio-backend-osj9.onrender.com";

    // One ID per visitor, saved in this browser. It must start with "web-".
    function getUserId() {
      let id = localStorage.getItem("lab_user_id");
      if (!id) {
        id = "web-" + Math.random().toString(16).slice(2, 14);
        localStorage.setItem("lab_user_id", id);
      }
      return id;
    }

    // Sends one request to the backend and stops with an error if it fails.
    async function post(path, body) {
      const response = await fetch(BACKEND + path, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });
      if (!response.ok) {
        throw new Error(path + " failed with status " + response.status);
      }
      return response.json();
    }

    document.getElementById("signup").addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = document.getElementById("status");
      status.textContent = "Sending...";
      const userId = getUserId();
      try {
        await post("/identify", {
          user_id: userId,
          traits: {
            email: document.getElementById("email").value,
            first_name: document.getElementById("first_name").value
          }
        });
        await post("/track", {
          user_id: userId,
          event: "form_submitted",
          properties: { form: "signup" }
        });
        status.textContent = "Thank you! Your details were sent.";
      } catch (error) {
        status.textContent = "Something went wrong. Please try again.";
        console.error(error);
      }
    });
  </script>
<script>
  document.addEventListener("click", function (event) {
    var element = event.target.closest("[data-track]");
    if (!element) return;
    cioanalytics.track(element.getAttribute("data-track"), {
      label: element.textContent.trim().slice(0, 80),
      page: window.location.pathname
    });
  });
</script>
