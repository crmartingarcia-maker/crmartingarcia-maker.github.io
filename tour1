                <rect x="134" y="380" width="132" height="24" fill="#7a9470"/>
                <rect x="142" y="358" width="116" height="24" fill="#94ac89"/>
                <rect x="150" y="336" width="100" height="24" fill="#b0c4a6"/>

                <!-- guide on the stairs -->
                <g fill="#223226">
                  <circle cx="200" cy="344" r="6.5"/>
