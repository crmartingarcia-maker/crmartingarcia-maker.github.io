  <meta name="description" content="The Hidden Closes Stroll is a gentle two-hour walk through narrow passages and quiet courtyards, led by a guide from the fictional Edinburgh Tours.">
  <style>
    :root {
      --sage-50: #f3f6f0;
      --sage-100: #e4ebdd;
      --sage-200: #cddac4;
      --sage-300: #b0c4a6;
      --sage-400: #94ac89;
      --sage-500: #7a9470;
      --sage-600: #5f7a57;
      --sage-700: #48613f;
      --sage-800: #334a35;
      --sage-900: #223226;
      --butter: #f4ecd2;
      --ink: #1d2b21;
      --muted: #3f5443;
      --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, serif;
      --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: var(--sans);
      font-size: 1.0625rem;
      line-height: 1.65;
      color: var(--ink);
      background: var(--sage-50);
    }

    a { color: inherit; }

    .skip-link {
      position: absolute;
      left: 1rem;
      top: -4rem;
      z-index: 20;
      padding: 0.6rem 1rem;
      color: #fff;
      background: var(--sage-900);
      border-radius: 8px;
    }
    .skip-link:focus { top: 1rem; }

    .wrap {
      width: min(1120px, 100% - 2.5rem);
      margin-inline: auto;
    }

    :focus-visible {
      outline: 3px solid var(--sage-900);
      outline-offset: 3px;
    }

    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 18%, rgba(244, 236, 210, 0.85) 0, rgba(244, 236, 210, 0) 38%),
        radial-gradient(circle at 92% 80%, rgba(148, 172, 137, 0.55) 0, rgba(148, 172, 137, 0) 45%),
        linear-gradient(165deg, #e9f0e3 0%, #d5e1cb 55%, #c2d3b7 100%);
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.4rem 0;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      font-family: var(--serif);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--sage-900);
      text-decoration: none;
    }
    .brand svg { width: 34px; height: 30px; flex: none; }

    .nav { display: flex; align-items: center; gap: 1.6rem; }
    .nav a {
      color: var(--sage-900);
      font-weight: 600;
      font-size: 0.98rem;
      text-decoration: none;
    }
    .nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
    .nav .nav-join {
      padding: 0.5rem 1.15rem;
      color: #fff;
      background: var(--sage-800);
      border-radius: 999px;
    }
    .nav .nav-join:hover { background: var(--sage-900); text-decoration: none; }

    .hero-inner {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
      align-items: center;
      padding: 2.5rem 0 9rem;
    }

    .next-class {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      margin: 0 0 1.5rem;
      padding: 0.4rem 1rem 0.4rem 0.8rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--sage-900);
      background: rgba(255, 255, 255, 0.65);
      border: 1px solid var(--sage-300);
      border-radius: 999px;
    }
    .next-class::before {
      content: "";
      flex: none;
      width: 0.65rem;
      height: 0.65rem;
      background: var(--sage-600);
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(95, 122, 87, 0.25);
    }

    .hero h1 {
      margin: 0 0 1.4rem;
      font-family: var(--serif);
      font-weight: 700;
      font-size: clamp(2.8rem, 6.4vw, 5rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      color: var(--sage-900);
    }
    .hero .lede {
      margin: 0 0 1.5rem;
      max-width: 33rem;
      font-size: 1.2rem;
      line-height: 1.6;
      color: var(--muted);
    }

    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 0 0 2rem;
      padding: 0;
      list-style: none;
    }
    .facts li {
      padding: 0.3rem 0.95rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--sage-800);
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid var(--sage-300);
      border-radius: 999px;
    }

    .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
    .btn {
      display: inline-block;
      padding: 0.95rem 1.8rem;
      font: inherit;
      font-weight: 700;
      text-decoration: none;
      border-radius: 999px;
      border: 2px solid var(--sage-800);
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .btn-primary { color: #fff; background: var(--sage-800); }
    .btn-primary:hover { background: var(--sage-900); border-color: var(--sage-900); }
    .btn-ghost { color: var(--sage-900); background: transparent; }
    .btn-ghost:hover { background: rgba(255, 255, 255, 0.6); }

    /* Arch illustration */
    .art { display: flex; justify-content: center; }
    .art svg {
      width: min(100%, 400px);
      height: auto;
      overflow: visible;
      filter: drop-shadow(0 26px 32px rgba(34, 50, 38, 0.2));
    }
    .breathe {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 8s ease-in-out infinite;
    }
    @keyframes breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.045); }
    }

    /* ---------- Sign-up band ---------- */
    .join {
      position: relative;
      z-index: 2;
      margin-top: -5.5rem;
      scroll-margin-top: 1rem;
    }
    .card {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2.5rem;
      align-items: center;
      padding: 2.5rem 2.75rem;
      background: #fcfdfb;
      border: 1px solid var(--sage-200);
      border-radius: 28px;
      box-shadow: 0 30px 60px rgba(34, 50, 38, 0.18);
    }
    .card h2 {
      margin: 0 0 0.6rem;
      font-family: var(--serif);
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      line-height: 1.15;
      color: var(--sage-900);
    }
    .card .intro { margin: 0; color: var(--muted); }

    .fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .field label {
      display: block;
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--sage-900);
    }
    .field input {
      display: block;
      width: 100%;
      margin-top: 0.4rem;
      padding: 0.85rem 1rem;
      font: inherit;
      color: var(--ink);
      background: #fff;
      border: 1.5px solid #6d8264;
      border-radius: 12px;
    }
    .field input:hover { border-color: var(--sage-800); }
    .field input:focus-visible {
      outline: 3px solid var(--sage-800);
      outline-offset: 2px;
      border-color: var(--sage-800);
    }

    button[type="submit"] {
      display: block;
      width: 100%;
      margin-top: 1.1rem;
      padding: 1rem 1.4rem;
      font: inherit;
      font-weight: 700;
      font-size: 1.05rem;
      color: #fff;
      background: var(--sage-800);
      border: 2px solid var(--sage-800);
      border-radius: 999px;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    button[type="submit"]:hover { background: var(--sage-900); border-color: var(--sage-900); }

    #status {
      min-height: 1.65em;
      margin: 0.9rem 0 0;
      font-weight: 600;
      color: var(--sage-800);
    }

    /* ---------- Route ---------- */
    .route-section {
      padding: 5.5rem 0 5rem;
      scroll-margin-top: 1rem;
    }
    .section-head { max-width: 38rem; margin-bottom: 2.5rem; }
    .section-head h2 {
      margin: 0 0 0.6rem;
      font-family: var(--serif);
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      line-height: 1.1;
      letter-spacing: -0.01em;
      color: var(--sage-900);
    }
    .section-head p { margin: 0; color: var(--muted); }

    .route {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 0;
      list-style: none;
      counter-reset: stop;
    }
    .route li {
      counter-increment: stop;
      display: grid;
      grid-template-columns: 3.5rem 1fr;
      gap: 0.4rem 1.5rem;
      align-items: center;
      padding: 1.3rem 1.75rem;
      background: #fff;
      border: 1px solid var(--sage-200);
      border-left: 8px solid var(--sage-400);
      border-radius: 18px;
    }
    .route li:nth-child(2) { border-left-color: var(--sage-500); }
    .route li:nth-child(3) { border-left-color: var(--sage-600); }
    .route li:nth-child(4) { border-left-color: var(--sage-700); }
    .route li:nth-child(5) { border-left-color: var(--sage-800); }
    .route li::before {
      content: counter(stop);
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      font-family: var(--serif);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--sage-900);
      background: var(--sage-100);
      border-radius: 50%;
    }
    .route strong {
      display: block;
      font-family: var(--serif);
      font-size: 1.3rem;
      line-height: 1.25;
      color: var(--sage-900);
    }
    .route span { color: var(--muted); }

    /* ---------- Good to know ---------- */
    .visit {
      padding: 5.5rem 0;
      background: var(--sage-100);
      scroll-margin-top: 1rem;
    }
    .visit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }
    .visit .section-head { margin-bottom: 0; }
    .visit .section-head .btn { margin-top: 1.75rem; }

    .panel {
      margin: 0;
      padding: 2.25rem 2.5rem;
      color: #eef3ea;
      background: var(--sage-800);
      border-radius: 28px;
    }
    .panel div + div { margin-top: 1.4rem; }
    .panel dt {
      margin: 0 0 0.15rem;
      font-family: var(--serif);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--sage-200);
    }
    .panel dd { margin: 0; }

    /* ---------- Footer ---------- */
    .site-footer {
      padding: 3rem 0 3.25rem;
      color: #d3dfcb;
      background: var(--sage-900);
    }
    .site-footer p { margin: 0.25rem 0; font-size: 0.97rem; }
    .site-footer .footer-brand {
      font-family: var(--serif);
      font-size: 1.3rem;
      font-weight: 700;
      color: #fff;
    }
    .site-footer a { color: #fff; text-underline-offset: 4px; }

    /* ---------- Tablet and phone ---------- */
    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 1.5rem 0 8rem;
      }
      .art svg { width: min(100%, 330px); }
      .card {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 2rem 1.75rem;
      }
      .visit-grid { grid-template-columns: 1fr; gap: 2rem; }
      .route li {
        grid-template-columns: 3rem 1fr;
        gap: 0.35rem 1rem;
        padding: 1.15rem 1.25rem;
      }
    }

    @media (max-width: 560px) {
      .nav a:not(.nav-join) { display: none; }
      .fields { grid-template-columns: 1fr; }
      .actions .btn { flex: 1 1 100%; text-align: center; }
      .panel { padding: 1.75rem 1.5rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .breathe { animation: none; }
      * { transition: none !important; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#signup-heading">Skip to the sign-up form</a>

  <div class="hero">
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">
          <svg viewBox="0 0 34 30" aria-hidden="true" focusable="false">
            <path d="M0 29 L9 17 L13 20 L19 12 L24 18 L28 14 L34 29 Z" fill="#5f7a57"/>
            <path d="M8 29 V15 H11 V13 H14 V15 H17 V13 H20 V15 H23 V29 Z" fill="#334a35"/>
            <path d="M15 15 V6 L18.5 1 L22 6 V15 Z" fill="#223226"/>
            <rect x="12" y="23" width="4" height="6" fill="#f4ecd2"/>
          </svg>
          Edinburgh Tours
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/">All tours</a>
          <a href="#route">The route</a>
          <a href="#visit">Good to know</a>
          <a class="nav-join" href="#join">Join</a>
        </nav>
      </header>

      <main id="top">
        <div class="hero-inner">
          <div>
            <p class="next-class">Next walk: Wednesday at 2:00 pm</p>
            <h1>Hidden Closes Stroll</h1>
            <p class="lede">Follow narrow passages and quiet courtyards through the heart of the old city. Your guide shares the stories behind every doorway and stairway along the way.</p>
            <ul class="facts" aria-label="Tour details">
              <li>About two hours</li>
              <li>Gentle pace</li>
              <li>Up to 14 guests</li>
            </ul>
            <div class="actions">
              <a class="btn btn-primary" href="/" aria-label="Book now: Hidden Closes Stroll" data-track="tour_page_book_clicked">Book now</a>
              <a class="btn btn-ghost" href="#route">See the route</a>
            </div>
          </div>

          <div class="art">
            <svg viewBox="-20 -20 440 540" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#f6efd6"/>
                  <stop offset="0.6" stop-color="#e6eedc"/>
                  <stop offset="1" stop-color="#d3e0c9"/>
                </linearGradient>
                <clipPath id="arch">
                  <path d="M0 476 V200 A200 200 0 0 1 400 200 V476 Q400 500 376 500 H24 Q0 500 0 476 Z"/>
                </clipPath>
              </defs>

              <path d="M-14 500 V200 A214 214 0 0 1 414 200 V500" fill="none" stroke="#94ac89" stroke-width="2.5"/>

              <g clip-path="url(#arch)">
                <rect x="0" y="0" width="400" height="500" fill="url(#sky)"/>

                <!-- light at the end of the close -->
                <g class="breathe">
                  <circle cx="200" cy="270" r="190" fill="none" stroke="#ffffff" stroke-opacity="0.22" stroke-width="2"/>
                  <circle cx="200" cy="270" r="158" fill="none" stroke="#ffffff" stroke-opacity="0.4" stroke-width="2"/>
                  <circle cx="200" cy="270" r="128" fill="none" stroke="#ffffff" stroke-opacity="0.6" stroke-width="2"/>
                  <circle cx="200" cy="270" r="100" fill="#fbf6e3"/>
                </g>

                <!-- left building -->
                <polygon points="14,160 62,112 110,160" fill="#5f7a57"/>
                <rect x="0" y="160" width="110" height="340" fill="#5f7a57"/>
                <rect x="26" y="206" width="16" height="22" fill="#223226"/>
